{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2018",
		"moduleResolution": "node",
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": ["DOM", "ES2018"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.mts"]
}
