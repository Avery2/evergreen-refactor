{
	"name": "evergreen-refactor",
	"version": "0.1.0",
	"description": "Reference a passage from your freeform writing in one or more notes, using native block references and embeds. The original text stays put and stays canonical.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"tests/**/*.test.mts\"",
		"build": "node esbuild.config.mjs production",
		"check": "npm run typecheck && npm run test && npm run build && npm run verify",
		"install:vault": "node scripts/install.mjs",
		"dev:vault": "node scripts/install.mjs --watch",
		"verify": "node scripts/verify-build.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"block-reference",
		"block-embed",
		"evergreen-notes",
		"note-composer",
		"refactor",
		"zettelkasten"
	],
	"devDependencies": {
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"typescript": "~5.6.0"
	}
}
